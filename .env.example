# Copiar este archivo y ponerle de nombre .env
# El archivo .env NO se sube a GitHub porque tiene las contraseñas

# Servidor donde está PostgreSQL
DB_HOST=localhost
# Puerto de PostgreSQL (el normal es 5432)
DB_PORT=5432
# Nombre de la base de datos
DB_NAME=gastrosena_db
# Usuario con el que la API entra a la base de datos (se crea en database/03_dcl.sql)
DB_USER=api_gastrosena
# Contraseña de ese usuario (tiene que ser la misma de 03_dcl.sql)
DB_PASSWORD=CambieEstaClave2026

# Clave secreta para firmar los tokens (poner una larga, se puede sacar con: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=pon_aqui_una_clave_secreta_larga
# Minutos que dura el token de acceso
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Días que dura el refresh token
REFRESH_TOKEN_EXPIRE_DAYS=7

# Páginas web que pueden usar la API desde el navegador (separadas por coma)
CORS_ORIGINS=http://localhost:5173,https://burbano52100.github.io

# Hora desde la que se puede reservar (7 = 7 de la mañana)
HORA_APERTURA=7
# Hora hasta la que se puede reservar (21 = 9 de la noche)
HORA_CIERRE=21
