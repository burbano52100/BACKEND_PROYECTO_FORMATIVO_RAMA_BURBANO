# Copie este archivo como .env y complete los valores reales.
# El archivo .env NO se sube a GitHub.

# Base de datos PostgreSQL (usuario de la API creado en database/03_dcl.sql)
# Servidor donde está PostgreSQL
DB_HOST=localhost
# Puerto de PostgreSQL
DB_PORT=5432
# Nombre de la base de datos
DB_NAME=gastrosena_db
# Esquema del proyecto
DB_SCHEMA=gastrosena
# Usuario con privilegios mínimos (no es postgres)
DB_USER=api_gastrosena
# Contraseña de ese usuario (la misma de 03_dcl.sql)
DB_PASSWORD=CambieEstaClave2026

# JWT: genere la clave con  python -c "import secrets; print(secrets.token_hex(32))"
# (mínimo 32 caracteres; con este texto de ejemplo la API no arranca)
# Clave secreta que firma los tokens
JWT_SECRET_KEY=genere_una_clave_con_secrets
# Algoritmo de firma
JWT_ALGORITHM=HS256
# Minutos que dura el token de acceso
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Días que dura el token de actualización
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seguridad
# Intentos fallidos antes de bloquear la cuenta
MAX_LOGIN_ATTEMPTS=5
# Minutos de bloqueo
LOCKOUT_MINUTES=15

# CORS: orígenes autorizados separados por coma (RT11)
# Páginas web que pueden llamar la API desde el navegador
CORS_ORIGINS=http://localhost:5173,https://burbano52100.github.io

# Reglas del negocio
# Desde qué hora se puede reservar o cancelar
HORA_INICIO_RESERVAS=07:00
# Hasta qué hora se puede reservar o cancelar
HORA_FIN_RESERVAS=21:00
# Días antes del vencimiento en que un material pasa a "VENCIENDO"
DIAS_ALERTA_VENCIMIENTO=7
# Porcentaje del stock mínimo por debajo del cual el material está "CRITICO"
PORCENTAJE_STOCK_CRITICO=50
# Días para pagar después del corte mensual antes de que la deuda quede "VENCIDA"
DIAS_PLAZO_PAGO=5
